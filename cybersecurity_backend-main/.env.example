# Database Configuration
# For local development:
MONGODB_URL=mongodb://localhost:27017
DATABASE_NAME=pentestlab
# For Docker Compose:
# MONGODB_URL=mongodb://admin:admin123@db:27017
# For MongoDB Atlas (cloud):
# MONGODB_URL=mongodb+srv://user:password@cluster.mongodb.net/?retryWrites=true&w=majority

# Security Configuration - CHANGE THIS IN PRODUCTION
SECRET_KEY=your-super-secret-jwt-key-change-this-in-production-minimum-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=60
ALGORITHM=HS256

# AI Integration (Optional - for AI report generation and Security Copilot)
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=openai/gpt-oss-120b

# External APIs (Optional - for passive reconnaissance)
SHODAN_API_KEY=your-shodan-api-key-here

# Security tools configuration
# Binaries are auto-detected from PATH; set explicitly here if needed:
# NIKTO_PATH=/usr/bin/nikto
# GOBUSTER_PATH=/usr/local/bin/gobuster
# GOBUSTER_WORDLIST=/usr/share/wordlists/dirb/common.txt
# Nmap: set NMAP_SCAN_ALL_PORTS=true for a full 1-65535 scan (much slower)
NMAP_SCAN_ALL_PORTS=false
NMAP_TOP_PORTS=1000
NMAP_HOST_TIMEOUT=120s
NIKTO_TIMEOUT=300
GOBUSTER_TIMEOUT=300
GOBUSTER_THREADS=20

# Application Configuration
ENVIRONMENT=development
DEBUG=true
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Logging Configuration
LOG_LEVEL=INFO
LOG_FILE=logs/pentestlab.log
